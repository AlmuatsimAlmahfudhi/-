# مفتاح Gemini API — احصل عليه مجاناً من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# نماذج قابلة للتغيير (يمكن تعديلها أيضاً من صفحة الإعدادات داخل الموقع)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
